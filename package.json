{
  "name": "g-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier src/ --write",
    "migration:generate": "drizzle-kit generate",
